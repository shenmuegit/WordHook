{
  "manifest_version": 3,
  "name": "WordHook",
  "version": "0.3.1",
  "description": "Select English to learn: LLM-grade explanations, TTS, one-click Anki export.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "assets/icons/wordhook-16.png",
    "32": "assets/icons/wordhook-32.png",
    "48": "assets/icons/wordhook-48.png",
    "128": "assets/icons/wordhook-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "WordHook",
    "default_icon": {
      "16": "assets/icons/wordhook-16.png",
      "32": "assets/icons/wordhook-32.png",
      "48": "assets/icons/wordhook-48.png",
      "128": "assets/icons/wordhook-128.png"
    },
    "default_popup": "popup.html"
  }
}
